{
  "name": "invitacion-digital",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Plantilla de invitacion digital personalizada por invitado, con RSVP sobre Google Sheets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
