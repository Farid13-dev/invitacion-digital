# ─────────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env` y rellena los valores.
#
# REGLA IMPORTANTE: todo lo que empiece por VITE_ se incrusta en el JavaScript
# que descarga el navegador, y cualquiera puede leerlo. Las variables sin ese
# prefijo solo las usa el script de Python en tu máquina y nunca salen de ahí.
# ─────────────────────────────────────────────────────────────────────────


# ═══ La invitación (navegador) ═══════════════════════════════════════════

# URL /exec de la Web App de Apps Script que guarda las confirmaciones.
# Paso a paso en apps-script/README.md
VITE_RSVP_ENDPOINT="https://script.google.com/macros/s/AKfycb.../exec"


# ═══ El script de envío (tu máquina) ═════════════════════════════════════

# Dominio público donde está desplegada la invitación, sin barra final.
INVITACION_URL="https://tu-invitacion.vercel.app"

# El MISMO valor que la propiedad de script SECRETO_RSVP del Apps Script.
# Firma los enlaces para que un invitado no pueda leer ni sobrescribir la
# confirmación de otro.
#
#   NO lo pongas en Vercel. NO lo prefijes con VITE_. Si llega al navegador,
#   deja de servir para nada.
#
# Genéralo con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRETO_RSVP=""

# Indicativo telefónico del país, sin el "+". 57 = Colombia.
INDICATIVO_PAIS="57"
